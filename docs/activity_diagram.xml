          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Address Valid? Yes -> Select Payment -->
        <mxCell id="e8" value="Ya" edge="1" parent="1" source="validate_address" target="select_payment">
          <mxGeometry relative="1" as="geometry">
