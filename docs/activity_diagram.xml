             <Array as="points">
              <mxPoint x="490" y="540" />
              <mxPoint x="220" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>
        
         <!-- Address Valid? No -> Back -->
        <mxCell id="e9" value="Tidak" edge="1" parent="1" source="validate_address" target="input_address">
          <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="530" y="440" />
              <mxPoint x="530" y="380" />
              <mxPoint x="190" y="380" />
